{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {},
  "resources": [
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2022-06-01",
      "name": "dcr-security-events",
      "location": "eastus",
      "kind": "Windows",
      "properties": {
        "dataSources": {
          "windowsEventLogs": [
            {
              "name": "securityEventsDataSource",
              "streams": ["Microsoft-SecurityEvent"],
              "xPathQueries": ["Security!*"]
            }
          ]
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "/subscriptions/4a153f29-9cbb-4827-8945-df8eb83969d7/resourceGroups/sentinel-lab-rg/providers/Microsoft.OperationalInsights/workspaces/sentinel-lab-workspace",
              "name": "sentinelWorkspace"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": ["Microsoft-SecurityEvent"],
            "destinations": ["sentinelWorkspace"]
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-03-01",
      "name": "Sentinel-Windows-VM/AzureMonitorWindowsAgent",
      "location": "eastus",
      "properties": {
        "publisher": "Microsoft.Azure.Monitor",
        "type": "AzureMonitorWindowsAgent",
        "typeHandlerVersion": "1.20",
        "autoUpgradeMinorVersion": true,
        "enableAutomaticUpgrade": true
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRuleAssociations",
      "apiVersion": "2022-06-01",
      "scope": "[resourceId('Microsoft.Compute/virtualMachines', 'Sentinel-Windows-VM')]",
      "name": "dcr-association-security-events",
      "properties": {
        "dataCollectionRuleId": "[resourceId('Microsoft.Insights/dataCollectionRules', 'dcr-security-events')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionRules', 'dcr-security-events')]",
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', 'Sentinel-Windows-VM', 'AzureMonitorWindowsAgent')]"
      ]
    }
  ]
}
